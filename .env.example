# GROQ_API_KEY: Optional/Primary key for Groq free-tier inference (Llama 3.3 70B & Whisper Large v3 Turbo).
# Configure this in the Secrets panel in the AI Studio UI.
GROQ_API_KEY="MY_GROQ_API_KEY"

# GEMINI_API_KEY: Required for Gemini AI API calls (also used if GROQ_API_KEY is not set).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WAITLIST_SECRET_ROUTE & WAITLIST_ADMIN_KEY: Private server-only route (must start with /api/)
# and secret passphrase to download the waitlist Excel workbook. Never exposed to the browser.
WAITLIST_SECRET_ROUTE="MY_WAITLIST_SECRET_ROUTE"
WAITLIST_ADMIN_KEY="MY_WAITLIST_ADMIN_KEY"

# SUPABASE_URL & SUPABASE_SERVICE_ROLE_KEY: Server-side Supabase PostgreSQL database credentials.
# Run /supabase/schema.sql in Supabase SQL Editor, then set these in Secrets / Vercel Env Vars.
SUPABASE_URL="MY_SUPABASE_URL"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# Meta WhatsApp Business Cloud API credentials (server-side only):
WHATSAPP_VERIFY_TOKEN="MY_WHATSAPP_VERIFY_TOKEN"
WHATSAPP_ACCESS_TOKEN="MY_WHATSAPP_ACCESS_TOKEN"
WHATSAPP_APP_SECRET="MY_WHATSAPP_APP_SECRET"
WHATSAPP_PHONE_NUMBER_ID="MY_WHATSAPP_PHONE_NUMBER_ID"


